{
  "version": "0.8.0-alpha",
  "containerId": "CLI-LXC-GA-Egress-Deny",
  "containment": "lxc",
  "process": {
    "commandLine": "sh -c \"timeout 8 nc -n -z -w 5 1.1.1.1 443 >/dev/null 2>&1 && echo MXC_NET_ALLOWED || echo MXC_NET_BLOCKED\""
  },
  "lifecycle": {
    "destroyOnExit": true
  },
  "lxc": {
    "distribution": "alpine",
    "release": "3.23"
  },
  "network": {
    "egress": {
      "default": "deny"
    }
  }
}
